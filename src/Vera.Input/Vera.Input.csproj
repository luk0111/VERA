<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(VeraWindowsTfm)</TargetFramework>
    <!-- Clipboard fallback uses System.Windows.Forms.Clipboard. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Required by CsWin32-generated interop. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vera.Input.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Vera.Input.Abstractions/Vera.Input.Abstractions.csproj" />
  </ItemGroup>

</Project>
