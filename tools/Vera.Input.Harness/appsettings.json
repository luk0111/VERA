{
  "VeraInput": {
    "Display": {
      "ExpectedWidth": 1920,
      "ExpectedHeight": 1080,
      "ExpectedScalePercent": 100,
      "CaptureTarget": "PrimaryMonitor",
      "MonitorIndex": 0,
      "StrictMismatch": false
    },
    "Capture": {
      "DefaultScale": 1.0,
      "MaxLongEdge": null,
      "BlackLuminanceThreshold": 10,
      "BlackPixelRatio": 0.995,
      "SampleStride": 4,
      "StaleWarningAfterIdenticalFrames": 10
    },
    "Rdp": {
      "Enabled": true,
      "WindowClass": "TscShellContainerClass",
      "RequireForeground": true,
      "WinKeyForwarded": false
    },
    "Delays": {
      "AfterMove": 50,
      "MouseDownUp": 50,
      "BetweenClicks": 80,
      "AfterClick": 300,
      "BetweenKeystrokes": 15,
      "AfterKey": 200,
      "AfterType": 300,
      "AfterScroll": 300,
      "ScrollNotch": 30,
      "DragSteps": 20,
      "DragStepDelay": 15,
      "HoverDwell": 800,
      "ClipboardSync": 400
    },
    "Text": {
      "DefaultMethod": "Auto",
      "AutoClipboardFor": "Never",
      "RestoreClipboard": true
    },
    "Journal": {
      "Enabled": false,
      "ScreenshotAfterEachAction": true,
      "Folder": "runs",
      "ScreenshotScale": 0.5
    }
  }
}