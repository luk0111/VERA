{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Warning",
          "outputTemplate": "[{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/harness-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "VeraInput": {
    "Display": {
      "ExpectedWidth": 1920,
      "ExpectedHeight": 1080,
      "ExpectedScalePercent": 100,
      "CaptureTarget": "PrimaryMonitor",
      "MonitorIndex": 0,
      "StrictMismatch": false
    },
    "Capture": {
      "DefaultScale": 1.0,
      "MaxLongEdge": null,
      "BlackLuminanceThreshold": 10,
      "BlackPixelRatio": 0.995,
      "SampleStride": 4,
      "StaleWarningAfterIdenticalFrames": 10
    },
    "Rdp": {
      "Enabled": true,
      "WindowClass": "TscShellContainerClass",
      "RequireForeground": true,
      "WinKeyForwarded": false
    },
    "Delays": {
      "AfterMove": 50,
      "MouseDownUp": 50,
      "BetweenClicks": 80,
      "AfterClick": 300,
      "BetweenKeystrokes": 15,
      "AfterKey": 200,
      "AfterType": 300,
      "AfterScroll": 300,
      "ScrollNotch": 30,
      "DragSteps": 20,
      "DragStepDelay": 15,
      "HoverDwell": 800,
      "ClipboardSync": 400
    },
    "Text": {
      "DefaultMethod": "Auto",
      "AutoClipboardFor": "Never",
      "RestoreClipboard": true
    },
    "Journal": {
      "Enabled": false,
      "ScreenshotAfterEachAction": true,
      "Folder": "runs",
      "ScreenshotScale": 0.5
    }
  }
}